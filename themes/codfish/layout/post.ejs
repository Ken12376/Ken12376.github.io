<% const direction = direction_for(page); %>
<div class="article-layout"><article class="article-main glass-card"><header class="article-header"><a class="breadcrumb" href="<%- url_for(`/categories/${direction.name}/`) %>">题解菜单 / <%= direction.label %></a><div class="article-meta"><% if (page.source_author) { %><span>原文署名：<%= page.source_author %></span><% } %><span><%= page.source_event || '散题' %></span><% if (page.status === 'partial') { %><span class="status-partial">未完成记录</span><% } %><span class="post-category"><%= direction.name %></span><time datetime="<%= date_xml(page.date) %>"><%= date(page.date,'YYYY.MM.DD') %></time><span><%- icon('clock') %><%= reading_minutes(page) %> 分钟阅读</span></div><h1 class="article-title"><%= page.title %></h1><p class="article-summary"><%= strip_html(page.excerpt || '') %></p><div class="post-tags"><% page.tags.toArray().forEach(tag => { %><a href="<%- url_for('/writeups/') %>?q=<%= encodeURIComponent(tag.name) %>"># <%= tag.name %></a><% }) %></div></header><div class="article-body"><%- page.content %></div><footer class="article-end"><img src="<%- url_for('/assets/burger.jpg') %>" width="46" height="46" alt=""><p>双层鳕鱼堡<br><span>又拆开了一层，下道题见。</span></p><a class="text-link" href="<%- url_for('/writeups/') %>">返回题解菜单 <%- icon('arrow') %></a></footer></article><aside class="article-toc"><div class="glass-card"><span class="mini-label">ON THIS PAGE</span><h3>阅读目录</h3><%- toc(page.content, {list_number:false, class:'toc'}) %></div><a class="text-link" href="<%- url_for(`/categories/${direction.name}/`) %>">更多<%= direction.label %>题解 <%- icon('arrow') %></a></aside></div>
