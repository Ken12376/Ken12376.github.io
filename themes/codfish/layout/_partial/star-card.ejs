<a class="star-card glass-card" href="<%= repo.url %>" target="_blank" rel="noopener noreferrer" data-language="<%= repo.language || 'Other' %>" data-search="<%= [repo.full_name, repo.description, repo.language, ...repo.topics].join(' ').toLowerCase() %>"><div class="repo-heading"><%- icon('github') %><span class="repo-owner"><%= repo.owner %></span><span class="repo-arrow"><%- icon('diagonal') %></span></div><h3 class="repo-title"><%= repo.name %></h3><p class="repo-description"><%= repo.description || '留给下一次探索的开源灵感。' %></p><div class="repo-meta"><span class="repo-language"><i class="language-dot language-<%= (repo.language || 'other').toLowerCase().replace(/[^a-z]/g, '') %>"></i><%= repo.language || 'Other' %></span><span><%- icon('star') %> <%= compact_number(repo.stars) %></span></div></a>
