<% const direction = direction_for(post); %>
<a class="post-card" href="<%- url_for(post.path) %>" data-category="<%= direction.name %>" data-event="<%= post.source_event || '散题' %>" data-search="<%= [post.title, post.source_event, post.excerpt && strip_html(post.excerpt), direction.name, direction.label, ...post.tags.toArray().map(tag => tag.name)].join(' ').toLowerCase() %>">
  <div class="post-visual visual-<%= direction.name %>" aria-hidden="true"><span class="visual-number"><%= String(index + 1).padStart(2, '0') %></span><span class="visual-mark"><%= direction.mark %></span><span class="visual-label"><%= direction.name.toUpperCase() %></span></div>
  <div class="post-content"><div class="post-meta"><span class="post-category"><%= direction.label %></span><span><%= post.source_event || '散题' %></span><time datetime="<%= date_xml(post.date) %>"><%= date(post.date, 'YYYY.MM.DD') %></time><span><%= reading_minutes(post) %> 分钟</span><% if (post.status === 'partial') { %><span class="status-partial">未完成记录</span><% } %></div><h3 class="post-title"><%= post.title %></h3><p class="post-excerpt"><%= strip_html(post.excerpt || '').slice(0, 110) %></p><div class="post-tags"><% post.tags.toArray().slice(0, 3).forEach(tag => { %><span># <%= tag.name %></span><% }) %></div></div><span class="post-arrow"><%- icon('diagonal') %></span>
</a>
